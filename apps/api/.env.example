# APP_ENV=development|production|test
# production: set explicit CORS_ALLOW_ORIGINS (comma list, no *).
# Alembic: `alembic upgrade head` runs automatically on API startup (see app/main.py lifespan).
#
# Railway (monorepo): set the service Root Directory to apps/api (Settings → Root Directory).
# If APP_ENV=production on Railway, you MUST set CORS_ALLOW_ORIGINS or the API will crash at import.
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/treasuryos

# API auth (recommended in production). If API_KEYS is set, calls must send X-API-Key.
# In production, set API_KEYS or explicitly set ALLOW_PUBLIC_API_IN_PROD=true.
# API_KEYS=key1,key2
# ALLOW_PUBLIC_API_IN_PROD=false

# Comma-separated browser origins. Use * only in dev/test. Required explicit list when APP_ENV=production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true only with explicit CORS_ALLOW_ORIGINS (never with *).
CORS_ALLOW_CREDENTIALS=false

# Override DB bootstrap: true=always run create_all+runtime columns, false=never (Alembic already ran).
# AUTO_CREATE_SCHEMA=

# Temporary debug: include SQL error text in 503 responses from vault routes (unset after fixing DB).
# EXPOSE_DB_ERROR_DETAIL=false

# Optional: Redis Streams feed for POST /proposals/.../evaluate decisions. Local: docker compose in infra/
# REDIS_URL=redis://localhost:6379/0

# --- Mantle mainnet (TreasuryOS deploy, verified on-chain) ---
# Railway: API service → Variables — paste the same keys; never commit real keys.
# Public RPC; use your own if you hit rate limits.
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_CHAIN_ID=5000
EXECUTION_LOG_CONTRACT=0xA22ebFf573BedA62202490A87eCE31C7c91462b9
# Funded account on Mantle mainnet (same or different from deployer). Leave empty to disable on-chain tx from API.
TREASURY_EXECUTOR_PRIVATE_KEY=
TREASURY_EXECUTOR_MNEMONIC=

# Sepolia instead of mainnet: MANTLE_CHAIN_ID=5003, RPC https://rpc.sepolia.mantle.xyz, and your Sepolia ExecutionLog address.
