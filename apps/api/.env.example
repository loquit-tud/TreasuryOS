# APP_ENV=development|production|test
# production: set explicit CORS_ALLOW_ORIGINS (comma list, no *). Run: alembic upgrade head
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/treasuryos

# Comma-separated browser origins. Use * only in dev/test. Required explicit list when APP_ENV=production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true only with explicit CORS_ALLOW_ORIGINS (never with *).
CORS_ALLOW_CREDENTIALS=false

# Override DB bootstrap: true=always run create_all+runtime columns, false=never (use Alembic).
# AUTO_CREATE_SCHEMA=

MANTLE_RPC_URL=
MANTLE_CHAIN_ID=5000
EXECUTION_LOG_CONTRACT=
TREASURY_EXECUTOR_PRIVATE_KEY=
TREASURY_EXECUTOR_MNEMONIC=
